# ============================================================
# AuraStyle — Variáveis de ambiente (todas GRATUITAS)
# ============================================================
# Copie este arquivo para .env.local e preencha com suas chaves.
# Todas as APIs listadas abaixo são gratuitas no plano free.
#
# Como obter:
# 1. Acesse https://console.firebase.google.com
# 2. Crie um projeto (ou use existente)
# 3. Vá em Project Settings > General > Your apps > Web app
# 4. Copie as credenciais abaixo
# 5. Para Vision/Places: https://console.cloud.google.com/apis/library
#
# SEM CHAVES = o app funciona em modo demo (localStorage)
# COM CHAVES  = sincronização na nuvem, IA real, salões reais
# ============================================================

# --- FIREBASE (obrigatório para nuvem) ---
# Obtido em: Firebase Console > Project Settings > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aurastyle.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aurastyle
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aurastyle.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- GOOGLE CLOUD VISION (análise de selfies) ---
# Obtido em: Google Cloud Console > APIs & Services > Credentials
# Ative a API: https://console.cloud.google.com/apis/library/vision.googleapis.com
# Free tier: 1.000 chamadas/mês
GOOGLE_VISION_API_KEY=

# --- GOOGLE PLACES (salões/lojas próximas) ---
# Obtido em: Google Cloud Console > APIs & Services > Credentials
# Ative a API: https://console.cloud.google.com/apis/library/places.googleapis.com
# Free tier: $200 USD de crédito/mês (~65.000 requisições)
GOOGLE_PLACES_API_KEY=

# --- FIREBASE ADMIN (opcional, para server-side) ---
# Obtido em: Firebase Console > Project Settings > Service Accounts
# Baixe a chave JSON e cole o conteúdo aqui (base64 encoded)
# Não use em produção sem segurança adequada
# FIREBASE_SERVICE_ACCOUNT_KEY=

# --- GEMINI (IA do Aura — chat JARVIS, análise de selfie, consultor de compras) ---
# Obtido em: https://aistudio.google.com/apikey (free tier generoso)
# Crie a chave e ative a "Generative Language API" no seu projeto do Google Cloud:
# https://console.cloud.google.com/apis/library/generativelanguage.googleapis.com
# SEM A CHAVE = o app usa o motor de IA alternativo e heurísticas locais (100% funcional)
GEMINI_API_KEY=

# --- OPÇÕES ADICIONAIS (futuras integrações gratuitas) ---

# Google Translate API — traduções multi-idioma
# Free tier: 500.000 caracteres/mês
# GOOGLE_TRANSLATE_API_KEY=

# Google Cloud Storage — upload de fotos do armário
# Free tier: 5 GB de armazenamento
# GOOGLE_CLOUD_STORAGE_BUCKET=

# Firebase Cloud Functions — notificações push agendadas
# Free tier: 2 milhões de invocações/mês, 400.000 GB-seg
# (não precisa de variável — configurado no Firebase Console)

# Firebase Remote Config — personalização remota
# (não precisa de variável — configurado no Firebase Console)
