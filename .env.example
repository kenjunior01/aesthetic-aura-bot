# AuraStyle — variáveis de ambiente
# COPIE este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o arquivo .env real.

# Banco local (Prisma/SQLite) — já configurado por padrão
DATABASE_URL=file:./db/custom.db

# Groq AI (plano gratuito) — https://console.groq.com/keys
# IA primária do Aura: chat, visão (Llama 4 Scout) e consultor de compras.
GROQ_API_KEY=

# Bancos de imagens do /api/galeria-visual (Espelho) — os DOIS intercalados.
# Pexels: https://www.pexels.com/api/ (200 req/h, grátis)
PEXELS_API_KEY=
# Unsplash: https://unsplash.com/developers → New Application → Access Key
# (50 req/h, grátis; só a Access Key — o Secret não é usado pelo servidor)
UNSPLASH_ACCESS_KEY=

# NOTA MOBILE: para compilar o APK com os bancos completos, cola as chaves
# em mobile/lib/core/secrets.dart (vazias no repo por segurança — GitHub
# Push Protection bloqueia chaves em commits públicos). Com chaves vazias
# o app usa o backend deste servidor + reserva embutida.

# Opcionais — ajuste fino dos modelos Groq
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# APIs GRATUITAS usadas (sem chave, sem config):
# - Open Beauty Facts  → produtos reais por código de barras (open data)
# - Open-Meteo         → clima ao vivo para o plano adaptativo
# - ipwho.is / geojs   → detecção de país/cidade do usuário
