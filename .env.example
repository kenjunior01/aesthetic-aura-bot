# AuraStyle — variáveis de ambiente
# COPIE este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o arquivo .env real.

# Banco local (Prisma/SQLite) — já configurado por padrão
DATABASE_URL=file:./db/custom.db

# Groq AI (plano gratuito) — https://console.groq.com/keys
# IA primária do Aura: chat, visão (Llama 4 Scout) e consultor de compras.
GROQ_API_KEY=

# Opcionais — ajuste fino dos modelos Groq
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# APIs GRATUITAS usadas (sem chave, sem config):
# - Open Beauty Facts  → produtos reais por código de barras (open data)
# - Open-Meteo         → clima ao vivo para o plano adaptativo
# - ipwho.is / geojs   → detecção de país/cidade do usuário
