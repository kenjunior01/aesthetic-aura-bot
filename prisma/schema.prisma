generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Banco de referências de estilo — arquétipos originais AuraStyle.
/// Cada look define traços faciais mensuráveis (base do matching) e o
/// plano de upgrade que ele "ensina". Não são pessoas reais: são
/// referências autoriais de estúdio, com traços canónicos.
model ReferenceLook {
  id String @id @default(cuid())

  slug    String @unique
  name    String
  tagline String
  image   String // caminho público /references/*.jpg
  order   Int    @default(0)

  // ── Traços mensuráveis (valores canónicos do matching) ──
  faceShape   String // oval | redondo | quadrado | retangular | coracao | losango | oblongo
  jawline     String // suave | equilibrado | marcado
  cheekbones  String // discretos | presentes | altos
  eyeShape    String // amendoados | redondos | fundos | expressivos
  browType    String // finos | naturais | marcados
  hairTexture String // liso | ondulado | cacheado | crespo
  facialHair  String // nenhum | cavanhaque-suave | barba-curta | barba-cheia

  skinToneCenter Int // 1-14 — centro do tom de pele

  // ── Conteúdo de estilo ──
  styleVibe String // uma frase de identidade
  signature String // JSON: string[] — assinaturas visuais do arquétipo
  upgrades  String // JSON: Record<traitKey, { area, action, why }> — o que ensinar

  createdAt DateTime @default(now())
}
